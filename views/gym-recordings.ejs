<div class="dash-shell">
  <div class="dash-side">
    <a href="/gym">Dashboard</a>
    <a href="/gym/fixtures">Fixtures</a>
    <a href="/gym/recordings" class="active">Wedgetail Recordings</a>
    <a href="/account">My Account</a>
    <a href="/guide/gym">Gym Guide</a>
  </div>
  <div class="dash-main">
    <div class="section-eyebrow">Wedgetail</div>
    <h2>Recordings</h2>
    <p style="color:var(--muted);margin-top:.3rem;">
      Every set Wedgetail recorded for one of your teams. Reps flagged below weren't necessarily bad —
      they're the ones closest to the line, worth a coach's second look. The live count during the
      fixture always stands; this is coaching material, not a scoring appeal.
    </p>

    <div class="table-wrap" style="margin-top:1.5rem;">
      <table>
        <tr><th>Date</th><th>Exercise</th><th>Lanes</th><th>Duration</th><th>Flagged Reps</th><th></th></tr>
        <% if (recordings.length === 0) { %>
          <tr><td colspan="6" style="color:var(--muted);text-align:center;padding:1.5rem;">No recordings yet.</td></tr>
        <% } %>
        <% recordings.forEach(r => { %>
          <tr>
            <td><%= new Date(r.created_at).toLocaleString() %></td>
            <td><%= r.exercise_name %></td>
            <td><%= r.lane_a_label || '—' %> / <%= r.lane_b_label || '—' %></td>
            <td><%= r.duration_sec ? Math.round(r.duration_sec) + 's' : '—' %></td>
            <td><%= r.reviewFlagsParsed.length %></td>
            <td><a href="/gym/recordings/<%= r.id %>" class="btn btn-outline btn-sm">Watch</a></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
</div>
