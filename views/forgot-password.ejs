<section class="form-page">
  <div class="form-card">
    <h2>Forgot Password</h2>
    <% if (sent) { %>
      <p class="sub">If that email has an account, we've sent a link to reset the password. It expires in 1 hour.</p>
      <p class="helptext" style="margin-top:1.2rem;text-align:center;">
        <a href="/login" style="color:var(--forest);font-weight:700;">Back to log in</a>
      </p>
    <% } else { %>
      <p class="sub">Enter the email on your account and we'll send you a reset link.</p>
      <% if (error) { %><div class="form-error"><%= error %></div><% } %>
      <form method="POST" action="/forgot-password">
        <label>Email</label>
        <input type="email" name="email" required>
        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1.6rem;">Send Reset Link</button>
      </form>
      <p class="helptext" style="margin-top:1.2rem;text-align:center;">
        <a href="/login" style="color:var(--slate);">Back to log in</a>
      </p>
    <% } %>
  </div>
</section>
