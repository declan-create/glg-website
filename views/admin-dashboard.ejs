<div class="dash-shell">
  <div class="dash-side">
    <a href="/admin" class="active">Overview</a>
    <a href="/account">My Account</a>
  </div>
  <div class="dash-main">
    <div class="section-eyebrow">GLG HQ</div>
    <h2>Admin Overview</h2>

    <div class="grid grid-4" style="margin-top:1.2rem;">
      <div class="card"><div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:var(--forest);"><%= stats.users %></div><div style="color:var(--muted);font-size:.8rem;">Total Users</div></div>
      <div class="card"><div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:var(--forest);"><%= stats.gyms %></div><div style="color:var(--muted);font-size:.8rem;">Gyms Registered</div></div>
      <div class="card"><div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:var(--forest);"><%= stats.teams %></div><div style="color:var(--muted);font-size:.8rem;">Teams</div></div>
      <div class="card"><div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:var(--forest);"><%= stats.athletes %></div><div style="color:var(--muted);font-size:.8rem;">Athletes</div></div>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Data Storage</h3>
    <div class="card" style="margin-top:.8rem;border-left:5px solid <%= storage.persistent ? '#4a9d3f' : '#d64545' %>;">
      <% if (storage.persistent) { %>
        <div style="font-weight:700;color:#2f7a27;font-size:1.05rem;">Persistent — data survives deploys</div>
        <p style="color:var(--muted);font-size:.85rem;margin:.4rem 0 0;">
          Users, gyms, athletes, judge assignments and results are stored outside the code and are kept when you upload an update.
        </p>
      <% } else { %>
        <div style="font-weight:700;color:#d64545;font-size:1.05rem;">Not persistent — data is erased on every deploy</div>
        <p style="color:var(--muted);font-size:.85rem;margin:.4rem 0 0;">
          The app is using the database bundled with the code, so uploading an update replaces it and everything entered is lost.
          Fix: attach a volume mounted at <strong>/data</strong>, then set <strong>GLG_DB_PATH</strong> to <strong>/data/glg.db</strong>
          and <strong>GLG_SESSIONS_PATH</strong> to <strong>/data/sessions</strong>.
        </p>
      <% } %>
      <p style="color:var(--muted);font-size:.78rem;margin:.7rem 0 0;">
        Database file: <code><%= storage.dbPath %></code><br>
        This database was created: <strong><%= storage.firstBootAt %></strong>
        — if that timestamp changes after an update, the data was wiped.
      </p>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Notifications</h3>
    <div class="card" style="margin-top:.8rem;border-left:5px solid <%= adminNotifyConfigured ? '#4a9d3f' : '#d64545' %>;">
      <% if (adminNotifyConfigured) { %>
        <div style="font-weight:700;color:#2f7a27;font-size:1.05rem;">Email notifications are on</div>
        <p style="color:var(--muted);font-size:.85rem;margin:.4rem 0 0;">Every new gym, athlete signup, and region application sends an email here — the tables below are a backup, not the only place to check.</p>
      <% } else { %>
        <div style="font-weight:700;color:#d64545;font-size:1.05rem;">Email notifications are off</div>
        <p style="color:var(--muted);font-size:.85rem;margin:.4rem 0 0;">
          Set <strong>ADMIN_NOTIFY_EMAIL</strong> on Railway to get an email for every new gym, athlete, and region application.
          Until then, this page is the only place new signups show up — check back regularly.
        </p>
      <% } %>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Pending League Operator Applications</h3>
    <div class="table-wrap" style="margin-top:.8rem;">
      <table>
        <tr><th>Name</th><th>Email</th><th>Application</th><th></th></tr>
        <% if (pendingOperators.length === 0) { %>
          <tr><td colspan="4" style="color:var(--muted);text-align:center;padding:1.5rem;">No pending applications.</td></tr>
        <% } %>
        <% pendingOperators.forEach(o => { %>
          <tr>
            <td><%= o.first_name %> <%= o.last_name %></td>
            <td style="color:var(--muted);"><%= o.email %></td>
            <td style="white-space:pre-wrap;font-size:.8rem;max-width:300px;"><%= o.bio %></td>
            <td style="display:flex;gap:.5rem;">
              <form method="POST" action="/admin/operators/<%= o.id %>/approve"><button class="btn btn-primary btn-sm" type="submit">Approve</button></form>
              <form method="POST" action="/admin/operators/<%= o.id %>/reject" onsubmit="return confirm('Reject this application?')"><button class="btn btn-outline btn-sm" style="border-color:var(--danger);color:var(--danger);" type="submit">Reject</button></form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Recent Gym Signups</h3>
    <div class="table-wrap" style="margin-top:.8rem;">
      <table>
        <tr><th>Gym</th><th>Admin Contact</th><th>Region</th><th>Signed Up</th></tr>
        <% if (recentGyms.length === 0) { %>
          <tr><td colspan="4" style="color:var(--muted);text-align:center;padding:1.5rem;">No gyms yet.</td></tr>
        <% } %>
        <% recentGyms.forEach(g => { %>
          <tr>
            <td style="font-weight:600;"><%= g.name %></td>
            <td style="color:var(--muted);"><%= g.first_name %> <%= g.last_name %> — <%= g.email %></td>
            <td><%= g.region_name || '—' %></td>
            <td style="color:var(--muted);font-size:.82rem;"><%= new Date(g.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </table>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Recent Athlete Signups</h3>
    <div class="table-wrap" style="margin-top:.8rem;">
      <table>
        <tr><th>Name</th><th>Email</th><th>Region</th><th>Team</th><th>Signed Up</th></tr>
        <% if (recentAthletes.length === 0) { %>
          <tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1.5rem;">No athletes yet.</td></tr>
        <% } %>
        <% recentAthletes.forEach(a => { %>
          <tr>
            <td style="font-weight:600;"><%= a.first_name %> <%= a.last_name %></td>
            <td style="color:var(--muted);"><%= a.email %></td>
            <td><%= a.region_name || '—' %></td>
            <td><%= a.team_name || 'Unassigned' %></td>
            <td style="color:var(--muted);font-size:.82rem;"><%= new Date(a.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </table>
    </div>

    <h3 style="margin-top:2.2rem;font-size:1.4rem;color:var(--forest);">Regions</h3>
    <div class="table-wrap" style="margin-top:.8rem;">
      <table>
        <tr><th>Name</th><th>Level</th><th>Status</th><th></th></tr>
        <% regions.forEach(r => { %>
          <tr>
            <td><%= r.name %></td>
            <td style="text-transform:capitalize;color:var(--muted);"><%= r.level %></td>
            <td><span class="badge <%= r.status==='active' ? 'badge-live' : 'badge-soon' %>"><%= r.status %></span></td>
            <td><% if (r.level==='region') { %><a href="/admin/region/<%= r.id %>" style="color:var(--forest);font-weight:700;font-size:.85rem;">Manage →</a><% } %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
</div>
