<div class="dash-shell">
  <div class="dash-side">
    <a href="/gym" class="active">Dashboard</a>
    <a href="/gym/fixtures">Fixtures</a>
    <a href="/gym/recordings">Wedgetail Recordings</a>
    <a href="/account">My Account</a>
    <a href="/guide/gym">Gym Guide</a>
  </div>
  <div class="dash-main">
    <% if (welcome) { %><div class="form-success">Gym registered! Here's your dashboard.</div><% } %>
    <% if (judgesGenerated) { %><div class="form-success">Judge logins are ready — check your email for the list.</div><% } %>
    <div class="section-eyebrow">Gym Dashboard</div>
    <h2><%= gym.name %></h2>
    <p style="color:var(--muted);margin-top:.3rem;">Manage your teams and roster.</p>

    <h3 style="margin-top:2rem;font-size:1.4rem;color:var(--forest);">Your Teams</h3>
    <div class="grid grid-3" style="margin-top:.8rem;">
      <% teams.forEach(t => { %>
        <a href="/gym/team/<%= t.id %>" class="card" style="display:block;">
          <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;color:var(--forest);"><%= t.name %></div>
          <div style="font-size:.82rem;color:var(--muted);margin-top:.3rem;"><%= rosterCounts[t.id] %> athletes · <%= t.division %></div>
        </a>
      <% }) %>
    </div>

    <div class="card" style="margin-top:1rem;">
      <form method="POST" action="/gym/teams/new" style="display:flex;gap:.8rem;align-items:flex-end;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label style="margin-top:0;">New Team Name</label>
          <input type="text" name="name" placeholder="e.g. Pymble Ravens" required>
        </div>
        <div style="min-width:160px;">
          <label style="margin-top:0;">Division</label>
          <select name="division">
            <option value="Open">Open</option>
            <option value="Elite">Elite</option>
            <option value="Beginner">Beginner</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">+ Add Team</button>
      </form>
    </div>

    <% if (pendingAttachmentRequests.length > 0) { %>
      <h3 style="margin-top:2.5rem;font-size:1.4rem;color:var(--forest);">Team Requests to Join You</h3>
      <p class="lede">These are captain-run teams asking to attach to your gym. Approving means you'll co-manage the roster with their captain — nothing is taken away from them.</p>
      <% pendingAttachmentRequests.forEach(r => { %>
        <div class="card" style="margin-top:.8rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.8rem;">
          <div>
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--forest);"><%= r.team_name %></div>
            <div style="font-size:.82rem;color:var(--muted);">Requested by <%= r.first_name %> <%= r.last_name %> (<%= r.email %>)</div>
          </div>
          <div style="display:flex;gap:.6rem;">
            <form method="POST" action="/gym/attachment-requests/<%= r.id %>/approve"><button type="submit" class="btn btn-primary btn-sm">Approve</button></form>
            <form method="POST" action="/gym/attachment-requests/<%= r.id %>/reject" onsubmit="return confirm('Reject this team\'s request to join you?')"><button type="submit" class="btn btn-outline btn-sm" style="border-color:var(--danger);color:var(--danger);">Reject</button></form>
          </div>
        </div>
      <% }) %>
    <% } %>

    <h3 style="margin-top:2.5rem;font-size:1.4rem;color:var(--forest);">Judge Logins</h3>
    <% if (generatedPasswords && generatedPasswords.length > 0) { %>
      <div class="form-success">
        <strong>New passwords generated</strong> — shown once, right here. Hand each login + password to whoever's judging that category today; they expire in 24 hours.
      </div>
      <div class="table-wrap" style="margin-top:.6rem;">
        <table>
          <tr><th>Category</th><th>Login Email</th><th>Password</th></tr>
          <% generatedPasswords.forEach(j => { %>
            <tr>
              <td><%= j.label %></td>
              <td style="font-family:'Roboto Mono',monospace;font-size:.85rem;color:var(--muted);"><%= j.email %></td>
              <td style="font-family:'Roboto Mono',monospace;font-size:.95rem;font-weight:700;"><%= j.password || '—' %></td>
            </tr>
          <% }) %>
        </table>
      </div>
    <% } %>
    <% if (allJudgesExist) { %>
      <p class="lede">One standing login per category — all mail routes to this same inbox (your email). Assign whichever's relevant when entering results for a fixture. Passwords expire after 24 hours, so generate a fresh set before each competition day.</p>
      <div class="table-wrap">
        <table>
          <tr><th>Category</th><th>Login Email</th></tr>
          <% standingJudges.forEach(j => { %>
            <tr><td><%= j.label %></td><td style="font-family:'Roboto Mono',monospace;font-size:.85rem;color:var(--muted);"><%= j.email %></td></tr>
          <% }) %>
        </table>
      </div>
      <form method="POST" action="/gym/judges/generate-passwords" style="margin-top:.8rem;">
        <button type="submit" class="btn btn-primary btn-sm">Generate Passwords</button>
      </form>
    <% } else { %>
      <p class="lede">Generate your 5 category-judge logins — one per category, all routing back to your own inbox. No need to set each one up by hand. Each gets its own random password (shown once, 24-hour expiry).</p>
      <form method="POST" action="/gym/judges/generate">
        <button type="submit" class="btn btn-primary btn-sm">Generate Judge Logins</button>
      </form>
    <% } %>

    <h3 style="margin-top:2.5rem;font-size:1.4rem;color:var(--forest);">Unassigned Athlete Pool — Your Region</h3>
    <p class="lede">Athletes who signed up asking to be assigned. Set a team for as many as you like below, then hit Assign once — no need to save each row separately.</p>
    <div class="table-wrap">
      <form id="poolAssignForm" method="POST" action="/gym/pool/assign"></form>
      <table>
        <tr><th>Name</th><th>Gender</th><th>Email</th><th>Assign To</th></tr>
        <% if (pool.length === 0) { %>
          <tr><td colspan="4" style="color:var(--muted);text-align:center;padding:1.5rem;">No unassigned athletes right now.</td></tr>
        <% } %>
        <% pool.forEach(p => { %>
          <tr>
            <td><%= p.first_name %> <%= p.last_name %></td>
            <td><%= p.gender %></td>
            <td style="color:var(--muted);"><%= p.email %></td>
            <td>
              <select name="assignments[<%= p.athlete_id %>]" form="poolAssignForm">
                <option value="">— leave unassigned —</option>
                <% teams.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
              </select>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
    <% if (pool.length > 0) { %>
      <button type="submit" form="poolAssignForm" class="btn btn-primary" style="margin-top:1rem;">Assign</button>
    <% } %>
  </div>
</div>
