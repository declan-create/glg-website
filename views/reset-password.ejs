<section class="form-page">
  <div class="form-card">
    <h2>Reset Password</h2>
    <% if (!valid) { %>
      <div class="form-error"><%= error || 'This reset link is invalid or has expired.' %></div>
      <p class="helptext" style="margin-top:1.2rem;text-align:center;">
        <a href="/forgot-password" style="color:var(--forest);font-weight:700;">Request a new reset link</a>
      </p>
    <% } else { %>
      <p class="sub">Choose a new password.</p>
      <% if (error) { %><div class="form-error"><%= error %></div><% } %>
      <form method="POST" action="/reset-password/<%= token %>">
        <label>New Password</label>
        <input type="password" name="password" required minlength="6">
        <label>Confirm Password</label>
        <input type="password" name="confirm_password" required minlength="6">
        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1.6rem;">Set New Password</button>
      </form>
    <% } %>
  </div>
</section>
